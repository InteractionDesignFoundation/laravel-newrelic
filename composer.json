{
    "name": "intouch/laravel-newrelic",
    "description": "Laravel NewRelic Integration",
    "license": "Apache 2.0",
    "type": "library",
    "keywords": [
        "newrelic",
        "new relic",
        "laravel"
    ],
    "authors": [
        {
            "name": "Patrick Leckey",
            "email": "pleckey@intouchinsight.com"
        }
    ],
    "homepage": "https://github.com/In-Touch/laravel-newrelic",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^10.0 || ^11.0 || ^12.0",
        "intouch/newrelic": "^2.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Intouch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Intouch\\LaravelNewrelic\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "aliases": {
                "Newrelic": "Intouch\\LaravelNewrelic\\Facades\\Newrelic"
            },
            "providers": [
                "Intouch\\LaravelNewrelic\\NewrelicServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
